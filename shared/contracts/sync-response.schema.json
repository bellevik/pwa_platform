{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwa-platform.local/schemas/sync-response.schema.json",
  "title": "Sync Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serverVersion",
    "ackedOperationIds",
    "rejectedOperations",
    "state",
    "serverTimestamp"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "serverVersion": {
      "type": "integer",
      "minimum": 0
    },
    "ackedOperationIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uuid"
      },
      "uniqueItems": true
    },
    "rejectedOperations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejectedOperation"
      }
    },
    "state": {
      "type": "object"
    },
    "serverTimestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "rejectedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
