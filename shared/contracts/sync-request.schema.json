{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwa-platform.local/schemas/sync-request.schema.json",
  "title": "Sync Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "deviceId",
    "lastKnownServerVersion",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "clientId": {
      "$ref": "#/$defs/uuid"
    },
    "deviceId": {
      "$ref": "#/$defs/uuid"
    },
    "lastKnownServerVersion": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityId",
        "type",
        "payload",
        "clientTimestamp",
        "deviceId",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "entityId": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "payload": {
          "type": "object"
        },
        "clientTimestamp": {
          "$ref": "#/$defs/isoTimestamp"
        },
        "deviceId": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "type": "string",
          "const": "pending"
        }
      }
    }
  }
}
